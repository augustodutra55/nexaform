# ── Supabase (obrigatório) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ── Provedores de IA (opcionais — sem eles o motor local assume) ──
# Anthropic (Claude) — melhor qualidade de geração
ANTHROPIC_API_KEY=
# OpenRouter — alternativa/fallback
OPENROUTER_API_KEY=
# Lista opcional, separada por vírgulas, de modelos :free voltados a coding.
# Os padrões internos continuam como fallback quando esta variável não existe.
OPENROUTER_FREE_MODELS=

# Limite persistente de gerações por usuário/hora (default 20)
GENERATION_RATE_LIMIT=20
GEN_MAX_MS=50000

# ── Integrações comerciais (opcionais) ─────────────────────────
# Stripe Checkout. Nunca exponha esta chave ao código gerado.
STRIPE_SECRET_KEY=
# Formulários e e-mails transacionais via Resend.
RESEND_API_KEY=
EMAIL_FROM=AD Studio <contato@seu-dominio.com>
# Webhooks HTTPS autorizados, separados por vírgula (n8n, Make etc.).
# Somente URLs listadas exatamente aqui podem receber eventos do AD Studio.
AUTOMATION_WEBHOOK_ALLOWLIST=https://n8n.seu-dominio.com/webhook/ad

# ── GitHub App por projeto (opcional) ───────────────────────────
# Use GitHub App; nunca salve PAT de cliente no banco.
GITHUB_APP_ID=
# PEM em uma linha com \n ou PEM multilinha conforme suporte do provedor.
GITHUB_APP_PRIVATE_KEY=
# Slug público do GitHub App, usado pela UI para abrir a instalação/autorização.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# ── Domínios personalizados via Vercel (opcional) ──────────────
# Token server-side com acesso ao projeto que hospeda o AD Studio.
VERCEL_TOKEN=
# ID (recomendado) ou nome do projeto Vercel que recebe os domínios.
VERCEL_PROJECT_ID=
# Alternativa ao ID, caso prefira referenciar o projeto pelo nome.
VERCEL_PROJECT_NAME=
# Necessário quando o projeto pertence a um Team.
VERCEL_TEAM_ID=

# ── Owner bypass ────────────────────────────────────────────────
# Emails (separados por vírgula) com acesso total a Pro/Team sem limites.
# O role 'owner' em profiles tem o mesmo efeito (ver migração 0002).
OWNER_EMAIL=augustodutra@gmail.com
NEXT_PUBLIC_OWNER_EMAIL=augustodutra@gmail.com

# URL pública do app (usada em links de compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
