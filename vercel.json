{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "src/app/api/generate-app/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/generation-jobs/worker/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/generation-jobs/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/automations/worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
